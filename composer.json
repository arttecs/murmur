{
    "name": "arttecs/murmur",
    "description": "A ReactPHP Server-Sent Events server with a Laravel bridge.",
    "keywords": [
        "laravel",
        "sse",
        "server-sent-events",
        "reactphp",
        "broadcasting",
        "realtime"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/arttecs/murmur",
    "support": {
        "issues": "https://github.com/arttecs/murmur/issues",
        "source": "https://github.com/arttecs/murmur",
        "security": "https://github.com/arttecs/murmur/security/policy"
    },
    "authors": [
        {
            "name": "Arthur Purcino",
            "homepage": "https://github.com/pvrcino"
        }
    ],
    "require": {
        "php": "^8.3",
        "react/http": "^1.12",
        "react/socket": "^1.17",
        "react/stream": "^1.4",
        "react/event-loop": "^1.6",
        "react/promise": "^3",
        "react/promise-timer": "^1.11",
        "firebase/php-jwt": "^7.2",
        "clue/redis-react": "^2.8",
        "psr/log": "^3.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/broadcasting": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/redis": "^12.0|^13.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "react/child-process": "^0.6.7"
    },
    "require-dev": {
        "pestphp/pest": "^4.0|^5.0",
        "orchestra/testbench": "^10.0|^11.0",
        "react/async": "^4",
        "laravel/pint": "^1.32"
    },
    "suggest": {
        "phpunit/phpunit": "Use the Murmur testing assertions and driver conformance test cases.",
        "ext-pcntl": "Drain connections on SIGTERM and SIGINT.",
        "ext-posix": "Let the worker detect parent death during a store write or listener call.",
        "ext-redis": "Use the Redis driver from Laravel. Alternatively, install predis/predis.",
        "ext-uv": "Support more than about 1000 concurrent connections.",
        "ext-ev": "Support more than about 1000 concurrent connections.",
        "ext-event": "Support more than about 1000 concurrent connections."
    },
    "autoload": {
        "psr-4": {
            "Arttecs\\Murmur\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arttecs\\Murmur\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arttecs\\Murmur\\MurmurServiceProvider"
            ],
            "aliases": {
                "Murmur": "Arttecs\\Murmur\\Facades\\Murmur"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
