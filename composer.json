{
    "name": "arttecs/murmur",
    "description": "A ReactPHP Server-Sent Events server with a Laravel bridge.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "react/http": "^1.12",
        "react/socket": "^1.17",
        "react/event-loop": "^1.6",
        "react/promise": "^3",
        "firebase/php-jwt": "^7.2",
        "clue/redis-react": "^2.8",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/broadcasting": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/redis": "^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0|^5.0",
        "orchestra/testbench": "^10.0|^11.0",
        "react/async": "^4",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "Arttecs\\Murmur\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arttecs\\Murmur\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arttecs\\Murmur\\MurmurServiceProvider"
            ],
            "aliases": {
                "Murmur": "Arttecs\\Murmur\\Facades\\Murmur"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
